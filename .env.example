# --- required (HELL refuses to start without these) ---
DATABASE_URL=postgres://user:pass@host:5432/hell
WS_SECRET=at-least-16-random-characters
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
EXPECTED_STATIC_IP=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=https://your-host/upstox/callback
UPSTOX_ALGO_NAME=exact-name-from-Upstox-My-Apps

# --- locked paper-graduation config (Stage 5) ---
STOP_TRIGGER_OFFSET_RS=6
STOP_LIMIT_FLOOR_OFFSET_RS=7.5
STOP_CHASER_MAX_SLIPPAGE_RS=9
DAILY_LOSS_CAP_RS=700
PER_TRADE_RISK_RS=460
MAX_TRADES_PER_DAY=1
MAX_WEEKLY_LOSS_RS=1400
TOTAL_CAPITAL_RS=10000

# --- exit chaser timing (ms) ---
EXIT_ESCALATE_AFTER_MS=3000
EXIT_ESCALATION_STEP_MS=1000
EXIT_FLOOR_WAIT_MS=30000

# --- optional ---
PORT=3000
NODE_ENV=production
# PGSSL=false   # only for a local Postgres without SSL
